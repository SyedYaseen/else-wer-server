# Compose variables for poochi (no secrets -- tracked). Consumed via
# `docker compose --env-file deploy/poochi/compose.env` (see root Makefile).
# Paths are relative to the repo root (the base compose file's directory).

# Same project name the stack was first started under from deploy/poochi/, so
# the existing container is updated in place rather than duplicated.
COMPOSE_PROJECT_NAME=poochi
# 3000 on the host is already taken by mzbe; 3030 is free.
HOST_PORT=3030
# Container env (JWT_SECRET etc.) -- gitignored, create from .env.example.
ENV_FILE=deploy/poochi/.env
DATA_DIR=./deploy/poochi/data
LOGS_DIR=./deploy/poochi/logs
# rw: the organize/upload paths write here.
AUDIOBOOKS_DIR=/home/poochi/hdd/bookshelf/audiobooks
