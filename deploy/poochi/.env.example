# Copy to .env on poochi and fill in. Every other setting has a default baked
# into the image (see the repo root Dockerfile): DATABASE_URL=sqlite:/data/else-wer.db,
# AUDIOBOOKS_LOCATION=/audiobooks, JWT_LOC=/data/creds/jwt.key,
# PWA_DIST_LOCATION=/app/src/ui/dist, HOST=0.0.0.0, PORT=3000, SELF_HOSTED=true.

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=

RUST_LOG=info

# Only needed if the PWA is ever served from a different origin than the API.
# The embedded PWA is same-origin, so leave this unset.
# CORS_ALLOWED_ORIGINS=
