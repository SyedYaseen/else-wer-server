# Copy to /etc/wireguard/wg-cloudflare.env on poochi (root-owned, chmod 600).
# Referenced by wg-wan-cloudflare-update.service's EnvironmentFile=.

# syedyaseen.dev zone ID (Cloudflare dashboard -> domain overview, right sidebar).
CF_ZONE_ID=

# API token scoped to Zone:DNS:Edit on the syedyaseen.dev zone. Must NOT also cover
# themizadah.com's zone -- keep this separate from mz/proxy's CF_DNS_API_TOKEN if that
# token stays single-zone; if it's the same widened multi-zone token used for the
# Traefik cfdns resolver (see docs/todo/15_ELSEWER_HOSTNAME_TLS.md), reusing it here is fine.
CF_API_TOKEN=

WG_HOSTNAME=wg.syedyaseen.dev
