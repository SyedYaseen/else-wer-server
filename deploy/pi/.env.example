# Pi's /home/pi/.env. `make pi-env` pushes this (fresh JWT_SECRET) only if the Pi has none.
JWT_SECRET=
AUDIOBOOKS_LOCATION=/home/pi/drv/AudioBooks
# The server's default (src/ui/dist, relative to /home/pi) doesn't resolve on the Pi.
PWA_DIST_LOCATION=/home/pi/else-wer-pwa/dist
DATABASE_URL=sqlite:./else-wer.db
HOST="0.0.0.0"
PORT=3000
JWT_LOC="../creds/jwt.key"
SELF_HOSTED=true
RELAY_URI=http://localhost:9000/api
RUST_LOG="info"

