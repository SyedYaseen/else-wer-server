# The Pi's ~/.env. `make pi-env` renders the @...@ values, adds a fresh JWT_SECRET and pushes
# it only if the Pi has none. Keep your real copy as deploy/pi/.env (gitignored).
JWT_SECRET=
AUDIOBOOKS_LOCATION=@PI_LIBRARY_MOUNT@/AudioBooks
# The server's default (src/ui/dist, relative to the home dir) doesn't resolve on the Pi.
PWA_DIST_LOCATION=@PI_HOME@/else-wer-pwa/dist
DATABASE_URL=sqlite:./else-wer.db
HOST="0.0.0.0"
PORT=3000
JWT_LOC="../creds/jwt.key"
SELF_HOSTED=true
RELAY_URI=http://localhost:9000/api
RUST_LOG="info"

