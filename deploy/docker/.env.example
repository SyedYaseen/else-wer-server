# Copy this file to .env.docker and fill in JWT_SECRET before running `docker compose up`.
# All other variables have sane defaults baked into the image (see Dockerfile) and only
# need to be set here if you want to override them.

# Required: any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Optional overrides:
# PORT=3000
# RUST_LOG=info

# Comma-separated list of origins allowed to make cross-origin API requests (e.g.
# https://app.example.com,https://other.example.com). Only needed if the frontend
# is served from a different origin than this API - the embedded PWA is same-origin
# and works with no origins configured. Empty/unset denies all cross-origin requests.
# CORS_ALLOWED_ORIGINS=
