# Copy to .env in this directory and set JWT_SECRET (`make env-init` does both).
# Compose reads this file for its own settings below AND passes it into the container.

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=

# ---- host settings (compose); defaults shown ----
# HOST_PORT=3000
# Your audiobook library (default: audiobooks/ at the repo root).
# AUDIOBOOKS_DIR=../../audiobooks
# DB, jwt key, covers / logs. A bare name is a named volume; a path (./data, /srv/else-wer)
# is a bind mount, which a non-root PUID needs.
# DATA_DIR=else-wer-data
# LOGS_DIR=else-wer-logs
# Run as this uid:gid (e.g. your user, so files written into the library aren't root-owned).
# PUID=0
# PGID=0
# COMPOSE_PROJECT_NAME=else-wer-server
# CONTAINER_NAME=else-wer

# ---- server settings (container) ----
# Image defaults (see Dockerfile): DATABASE_URL=sqlite:/data/else-wer.db,
# AUDIOBOOKS_LOCATION=/audiobooks, JWT_LOC=/data/creds/jwt.key,
# PWA_DIST_LOCATION=/app/src/ui/dist, HOST=0.0.0.0, PORT=3000, SELF_HOSTED=true.
RUST_LOG=info

# Comma-separated list of origins allowed to make cross-origin API requests (e.g.
# https://app.example.com). Only needed if the frontend is served from a different origin
# than this API - the embedded PWA is same-origin. Empty/unset denies all cross-origin requests.
# CORS_ALLOWED_ORIGINS=
