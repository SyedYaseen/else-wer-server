# Makefile settings for this machine. Real copy: .deploy.env (gitignored; `make env-init`).

# Docker deploy on another host over ssh (`make docker-deploy`). Empty = this machine.
DOCKER_SSH=
# Directory on that host holding its .env (made from deploy/docker/.env.example).
DOCKER_SSH_DIR=~/else-wer

# Pi (native binary + systemd, `make pi-*`).
PI_HOST=pi
PI_USER=pi
# PI_HOME=/home/pi
# Where the library drive is mounted; the service refuses to run without it.
# PI_LIBRARY_MOUNT=/home/pi/drv
# Filesystem UUID of the library drive (`blkid`), for the remount udev rule. Empty skips it.
PI_LIBRARY_UUID=
